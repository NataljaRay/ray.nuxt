{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "deploy": "npx gh-pages -d .output/public",
    "pages:build": "NUXT_APP_BASE_URL='/<repo>/' nuxt build --preset github_pages",
    "pages:deploy": "gh-pages -d .output/public",
    "pages:publish": "npm run pages:build && npm run pages:deploy"
  },
  "dependencies": {
    "nuxt": "^4.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "sass-embedded": "^1.90.0"
  }
}
